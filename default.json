{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "uinaf shared Renovate policy: daily, seven-day release age, patch and minor grouped, digest pinning.",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": [
    "* 0-5 * * *"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "prConcurrentLimit": 10,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "First-party reusable workflows track main by design; bumps land once in uinaf/.github",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "uinaf/.github"
      ],
      "enabled": false
    },
    {
      "description": "Group patch and minor updates per manager; majors stay separate",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin"
      ],
      "groupName": "{{manager}} patch and minor"
    },
    {
      "description": "Digest moves stay manual and get their own group so they never hold an automergeable patch or minor PR",
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "{{manager}} digests"
    },
    {
      "description": "Renovate merges grouped patch, minor, and pin updates itself after every visible check passes; repositories without checks and all majors stay manual. Digest-only updates carry no release timestamps, so the seven-day age gate cannot apply; they stay manual",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "GitHub Actions use the ci commit prefix",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci"
    },
    {
      "description": "OpenTofu registry for providers and modules",
      "matchDatasources": [
        "terraform-provider",
        "terraform-module"
      ],
      "registryUrls": [
        "https://registry.opentofu.org"
      ]
    },
    {
      "description": "required_version tracks OpenTofu releases, not Terraform",
      "matchManagers": [
        "terraform"
      ],
      "matchDepNames": [
        "hashicorp/terraform"
      ],
      "enabled": false
    },
    {
      "description": "Pin Actions and images by digest on the initial run without waiting for release age",
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "minimumReleaseAge": null,
      "schedule": [
        "at any time"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "mise pipx backends that the mise manager does not cover",
      "managerFilePatterns": [
        "/(^|/)mise\\.toml$/",
        "/(^|/)\\.mise\\.toml$/"
      ],
      "matchStrings": [
        "\"pipx:(?<depName>[^\"]+)\"\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Annotated version variables: # renovate: datasource=X depName=Y [versioning=Z] [extractVersion=RE]",
      "managerFilePatterns": [
        "/\\.ya?ml$/",
        "/(^|/)mise\\.toml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[a-z-]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+[\\w-]+:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "semanticCommitType": "deps",
  "semanticCommitScope": null,
  "automerge": false,
  "platformAutomerge": false,
  "automergeStrategy": "squash"
}
